# Telegram bot credentials
BOT_TOKEN=replace-with-telegram-bot-token
BOT_USERNAME=replace-with-bot-username
ADMIN_TELEGRAM_IDS=123456789

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters

# Public HTTPS origin used by Telegram links
PUBLIC_URL=https://example.com

# Runtime
TEAM_TZ=Europe/Moscow
DATABASE_URL=./data/planer.db
PORT=8080

# Личная карточка недели в Telegram. false возвращает прежнее меню; нужен рестарт.
MY_WEEK_WIDGET_ENABLED=false

# Вечерние напоминания в виде карточек. Для смены формата нужен рестарт.
SHIFT_REMINDER_WIDGET_ENABLED=false

# Чек-лист дежурного с отметками в чате. Для смены режима нужен рестарт.
CHECKLIST_WIDGET_ENABLED=false
