{
  "name": "planer-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "shared",
    "client",
    "server",
    "miniapp",
    "admin"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p client/tsconfig.json && tsc -p server/tsconfig.json && tsc -p admin/tsconfig.json && tsc -p miniapp/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
